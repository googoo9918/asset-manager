# Build output (including portable Node.js and disposable test databases)
/.gradle/
/build/
/out/

# Node dependencies and generated browser test reports
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
playwright-report/
test-results/

# Local connection settings and collected financial records
/.local/
/data/kb-card/
*.kbcard.json

# Local IDE settings
/.idea/
*.iml
/.vscode/

# Runtime logs and machine-specific configuration
/logs/
*.log
hs_err_pid*
replay_pid*
*.hprof
/application-local.yml
/application-local.yaml
/.env
/.env.*
!/.env.example

# Editor temporary files
*.swp
*.swo
*~

# Locally packaged browser extension and signing key
/tools/kb-card-extension.zip
/tools/kb-card-extension.crx
/tools/kb-card-extension.pem

# OS metadata
.DS_Store
Thumbs.db
