<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><c:out
        value="${pageTitle}"/> · 윱니와 동구</title><link rel="stylesheet" href="<c:url value='/app.css'/>"></head>
<body data-context="${pageContext.request.contextPath}">
<aside><a class="brand" href="<c:url value='/'/>">윱니와 동구</a>
    <nav>
        <a href="<c:url value='/'/>">대시보드</a><strong>자산</strong><a href="<c:url value='/assets'/>">전체 자산 요약</a><a
            href="<c:url value='/cash'/>">현금성 자산</a><a href="<c:url value='/savings'/>">적금</a><a
            href="<c:url value='/securities'/>">증권</a><a href="<c:url value='/cards'/>">카드</a><strong>부채</strong><a
            href="<c:url value='/loans'/>">대출</a><strong>수입 / 지출</strong><a
            href="<c:url value='/transactions'/>">거래내역</a><a href="<c:url value='/planned'/>">예정 거래</a><a
            href="<c:url value='/snapshots'/>">자산 스냅샷</a><a class="settings" href="<c:url value='/settings'/>">설정</a>
    </nav>
    <div class="mascot-pair"><img src="<c:url value='/images/pochacco.svg'/>" alt="포차코" width="82" height="95"><img
            src="<c:url value='/images/pompompurin.svg'/>" alt="폼폼푸린" width="82" height="95"></div>
    <p class="mascot-caption">차곡차곡, 우리 함께</p></aside>
<main>
    <header><h1 id="title"><c:out value="${pageTitle}"/></h1>
        <div><span>조회 기준</span>
            <div id="owner" class="segmented" role="group" aria-label="조회 기준">
                <button type="button" data-owner="WIFE" aria-pressed="false">윱니</button>
                <button type="button" data-owner="HUSBAND" aria-pressed="false">동구</button>
                <button type="button" data-owner="JOINT" aria-pressed="false">공동</button>
            </div>
            <button id="refresh">새로고침 · 스냅샷 저장</button>
        </div>
    </header>
    <div id="notice" role="status" aria-live="polite"></div>
    <section id="content" aria-busy="true">불러오는 중입니다.</section>
</main>
